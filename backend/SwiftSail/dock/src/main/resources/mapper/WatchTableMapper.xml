<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nyzg.dock.mapper.WatchTableMapper">
    <insert id="insertWatch" parameterType="com.nyzg.dock.dbobj.Watch">
        INSERT IGNORE INTO `watchTable`(`name`,
                                        `watchType`,
                                        `authorizeHeader`,
                                        `codeVerifier`,
                                        `clientId`,
                                        `activate`,
                                        `userId`)
        VALUES (#{name},
                #{watchType},
                #{authorizeHeader},
                #{codeVerifier},
                #{clientId},
                #{activate},
                #{userId})
    </insert>
    <update id="updateWatch">
        UPDATE `watchTable`
        SET `name`=#{watch.name},
            `authorizeHeader`=#{watch.authorizeHeader},
            `codeVerifier`=#{watch.codeVerifier},
            `activate`=#{watch.activate}
        WHERE `userId` = #{watch.userId}
          AND `clientId` = #{clientId};
    </update>
    <update id="updateWatchOffline">
        UPDATE watchTable
        SET expireTime=0,
            activate=0
        WHERE userId = #{userId}
          AND clientId = #{clientId};
    </update>
    <update id="updateWatchToken">
        UPDATE `watchTable`
        SET `clientId`=#{clientId},
            `accessToken`=#{accessToken},
            `refreshToken`=#{refreshToken},
            `watchUserId`=#{watchUserId},
            `expireTime`=#{expireTime}
        WHERE `clientId` = clientId;
    </update>
    <select id="checkSyncStatus">
        SELECT `clientId`,`expireTime` FROM `watchTable`
        WHERE `userId`=#{userId} AND `clientId` IN
        (<foreach collection="clientIdList" item="clientId" separator=",">#{clientId}</foreach>);
    </select>
    <select id="getWatchUserId">
        SELECT `watchUserId`
        FROM `watchTable`
        WHERE `userId` = #{userId}
          AND `clientId` = #{clientId};
    </select>
    <delete id="deleteWatch">
        DELETE
        FROM `watchTable`
        WHERE `userId` = #{userId}
          AND `clientId` = #{clientId};
    </delete>
    <select id="selectWatchByClientId">
        SELECT *
        FROM `watchTable`
        WHERE `userId` = #{userId}
          AND `clientId` = #{clientId};
    </select>

    <select id="checkExpireTime">
        SELECT `expireTime`, `authorizeHeader`, `refreshToken`
        FROM `watchTable`
        WHERE `clientId` = #{clientId};
    </select>
    <select id="selectWatchByUserId">
        SELECT *
        FROM watchTable
        WHERE userId = #{userId};
    </select>
    <update id="updateRefreshToken">
        UPDATE `watchTable`
        SET `accessToken`=#{accessToken},
            `refreshToken`=#{refreshToken},
            `expireTime`=#{expireTime}
        WHERE `clientId` = #{clientId};
    </update>
    <update id="markWatchExpire">
        UPDATE `watchTable`
        SET `expireTime`=0
        WHERE `clientId` = #{clientId};
    </update>
</mapper>