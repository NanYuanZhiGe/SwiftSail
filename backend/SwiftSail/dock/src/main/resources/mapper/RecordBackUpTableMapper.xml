<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nyzg.dock.mapper.RecordBackUpTableMapper">
    <insert id="insertRecordBackUpAndroid" parameterType="java.util.List">
        <if test="androidDataList != null and androidDataList.size() > 0">
            INSERT IGNORE INTO `recordBackUpTable` VALUES
            <foreach collection="androidDataList" separator="," item="androidData">
                (null,
                #{androidData.userId},
                #{androidData.recordId},
                #{androidData.exposeValue},
                #{androidData.detailValue},
                #{androidData.epochDay},
                #{androidData.epochWeek},
                #{androidData.epochMonth},
                #{androidData.epochYear}
                )
            </foreach>
        </if>
    </insert>
</mapper>