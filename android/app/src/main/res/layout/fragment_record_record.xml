<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/liteWhite"
    android:clickable="true">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/record_record_map_bk"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.nyzg.swiftsail.view.BackWardLayout
        android:id="@+id/backward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:bwTitle=""
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="350dp"
        android:layout_height="150dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/record_record_detail_bk"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/backward">

        <TextView
            android:id="@+id/durationTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="12dp"
            android:text="时长（分:秒）"
            android:textSize="@dimen/recordRecordTextSize"
            app:layout_constraintBottom_toBottomOf="@id/duration"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/duration" />

        <TextView
            android:id="@+id/duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="32dp"
            android:text="00:00"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/distanceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="距离（公里）"
            android:textSize="@dimen/recordRecordTextSize"
            app:layout_constraintBottom_toBottomOf="@id/distanceKilo"
            app:layout_constraintStart_toStartOf="@id/durationTitle"
            app:layout_constraintTop_toTopOf="@id/distanceKilo" />

        <TextView
            android:id="@+id/distanceKilo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/darkGreen"
            android:textSize="@dimen/recordRecordTextSize"
            app:layout_constraintBottom_toTopOf="@id/speed"
            app:layout_constraintEnd_toEndOf="@id/duration"
            app:layout_constraintTop_toBottomOf="@id/duration" />

        <TextView
            android:id="@+id/speedTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="配速（米每秒）"
            android:textSize="@dimen/recordRecordTextSize"
            app:layout_constraintBottom_toBottomOf="@id/speed"
            app:layout_constraintStart_toStartOf="@id/durationTitle"
            app:layout_constraintTop_toTopOf="@id/speed" />

        <TextView
            android:id="@+id/speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="--"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/duration" />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <com.nyzg.swiftsail.view.record.StageLayout
        android:id="@+id/stageLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>