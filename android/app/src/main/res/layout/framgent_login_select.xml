<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/mailLogin"
        android:layout_width="240dp"
        android:layout_height="80dp"
        android:layout_marginBottom="3dp"
        android:background="@drawable/account_layout_background"
        android:gravity="center"
        android:text="邮箱登录"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="24sp"
        app:layout_constraintBottom_toTopOf="@id/passwordLogin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/passwordLogin"
        android:layout_width="240dp"
        android:layout_height="80dp"
        android:layout_marginBottom="3dp"
        android:background="@drawable/account_layout_background"
        android:gravity="center"
        android:text="密码登录"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="24sp"
        app:layout_constraintBottom_toTopOf="@id/keyLogin"
        app:layout_constraintStart_toStartOf="@id/mailLogin"
        app:layout_constraintTop_toBottomOf="@id/mailLogin" />

    <TextView
        android:id="@+id/keyLogin"
        android:layout_width="240dp"
        android:layout_height="80dp"
        android:background="@drawable/account_layout_background"
        android:gravity="center"
        android:text="指纹登录"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/mailLogin"
        app:layout_constraintTop_toBottomOf="@id/passwordLogin" />
</androidx.constraintlayout.widget.ConstraintLayout>