<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/liteLiteWhite"
    android:clickable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/userManagerEntrance"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/headImage"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/head_icon"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/mineHeadIcon" />

        <TextView
            android:id="@+id/accountName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:text="本地账户"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/headImage"
            app:layout_constraintTop_toTopOf="@id/headImage" />

        <TextView
            android:id="@+id/accountId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="账户id：0"
            android:textColor="@color/liteWhite"
            app:layout_constraintStart_toStartOf="@id/accountName"
            app:layout_constraintTop_toBottomOf="@id/accountName" />

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="2dp"
            android:src="@drawable/chevron_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/liteWhite" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.nyzg.swiftsail.view.MineFuncSelectLayout
        android:id="@+id/funcSecurity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:funcIcon="@drawable/security"
        app:funcName="安全"
        app:iconTint="@color/golden"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/userManagerEntrance" />

    <com.nyzg.swiftsail.view.MineFuncSelectLayout
        android:id="@+id/funcMailBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1px"
        app:funcIcon="@drawable/mail"
        app:funcName="收信箱"
        app:iconTint="@color/lightBlue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/funcSecurity" />


    <com.nyzg.swiftsail.view.MineFuncSelectLayout
        android:id="@+id/funcCollection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:funcIcon="@drawable/collection"
        app:funcName="收藏"
        app:iconTint="@color/lightGreen"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/funcMailBox" />

    <com.nyzg.swiftsail.view.MineFuncSelectLayout
        android:id="@+id/funcSync"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1px"
        app:funcIcon="@drawable/sync"
        app:funcName="数据同步"
        app:iconTint="@color/linkGray"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/funcCollection" />

    <com.nyzg.swiftsail.view.MineFuncSelectLayout
        android:id="@+id/funcBottle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1px"
        app:funcIcon="@drawable/bottle"
        app:funcName="我的漂流瓶"
        app:iconTint="@color/skyBlue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/funcSync" />

    <com.nyzg.swiftsail.view.MineFuncSelectLayout
        android:id="@+id/funcLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:funcIcon="@drawable/logout"
        app:funcName="退出登录"
        app:iconTint="@color/lightPink"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/funcBottle"
        app:textColor="@color/lightRed" />

</androidx.constraintlayout.widget.ConstraintLayout>