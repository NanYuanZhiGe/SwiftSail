<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:sothree="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.sothree.slidinguppanel.SlidingUpPanelLayout
        android:id="@+id/slidingUpPanel"
        android:layout_width="match_parent"
        android:layout_height="800dp"
        android:background="@color/white"
        android:gravity="bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        sothree:umanoPanelHeight="68dp"
        sothree:umanoShadowHeight="4dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/reportContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/reportMainView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:background="@color/white">

                    <TextView
                        android:id="@+id/reportText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:text="运动报表"
                        android:textSize="18sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <com.nyzg.swiftsail.view.DateSelector
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="今天"
                        android:textSize="18sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/reportText" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/fourMainLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@id/date">

                        <com.nyzg.swiftsail.view.ReportCircle
                            android:id="@+id/sleep"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            app:circleBarWidth="20"
                            app:circleSize="160dp"
                            app:imageSize="70dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:textSize="12sp" />

                        <com.nyzg.swiftsail.view.ReportCircle
                            android:id="@+id/step"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            app:circleBk="@color/rainGreen"
                            app:circleBk2="@color/heavyGreen"
                            app:circleSize="90dp"
                            app:imageBk="@drawable/step"
                            app:imageSize="30dp"
                            app:layout_constraintEnd_toStartOf="@id/heart"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/sleep"
                            app:textSize="6sp" />

                        <com.nyzg.swiftsail.view.ReportCircle
                            android:id="@+id/heart"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:circleBk="@color/rainBlue"
                            app:circleBk2="@color/heavyBlue"
                            app:circleSize="90dp"
                            app:imageBk="@drawable/heart"
                            app:imageSize="30dp"
                            app:layout_constraintEnd_toStartOf="@id/consumtion"
                            app:layout_constraintStart_toEndOf="@id/step"
                            app:layout_constraintTop_toTopOf="@id/step"
                            app:textSize="6sp" />

                        <com.nyzg.swiftsail.view.ReportCircle
                            android:id="@+id/consumtion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:circleBk="@color/rainGreen"
                            app:circleBk2="@color/heavyGreen"
                            app:circleSize="90dp"
                            app:imageBk="@drawable/consumtion"
                            app:imageSize="30dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/heart"
                            app:layout_constraintTop_toTopOf="@id/step"
                            app:textSize="6sp" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/outOfParentData"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/fourMainLayout">

                        <TextView
                            android:id="@+id/textRecovery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="18dp"
                            android:text="恢复"
                            android:textSize="18sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/sleepLayout"
                            android:layout_width="340dp"
                            android:layout_height="110dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/report_rect_circle_bk"
                            android:padding="8dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/textRecovery">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="睡眠时长"
                                android:textSize="14sp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/sleepTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:text="无数据"
                                android:textSize="28sp"
                                app:layout_constraintBottom_toTopOf="@id/sleepScore"
                                app:layout_constraintStart_toStartOf="parent" />

                            <TextView
                                android:id="@+id/sleepScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="睡眠得分：---"
                                android:textSize="14sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent" />

                            <com.nyzg.swiftsail.view.ReportCircle
                                android:id="@+id/sleepCircle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:circleBk="@color/rainPurple"
                                app:circleBk2="@color/heavyPurple"
                                app:circleSize="70dp"
                                app:imageBk="@drawable/moon"
                                app:imageSize="25dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:textSize="0sp" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <TextView
                            android:id="@+id/textExercise"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="18dp"
                            android:layout_marginTop="16dp"
                            android:text="活动"
                            android:textSize="18sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/sleepLayout" />

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/stepLayout"
                            android:layout_width="340dp"
                            android:layout_height="110dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/report_rect_circle_bk"
                            android:padding="8dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/textExercise">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="步数"
                                android:textSize="14sp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/stepCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:text="无数据"
                                android:textSize="28sp"
                                app:layout_constraintBottom_toTopOf="@id/stepScore"
                                app:layout_constraintStart_toStartOf="parent" />

                            <TextView
                                android:id="@+id/stepScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="14sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent" />

                            <com.nyzg.swiftsail.view.ReportCircle
                                android:id="@+id/stepCircle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:circleBk="@color/rainGreen"
                                app:circleBk2="@color/heavyGreen"
                                app:circleSize="70dp"
                                app:imageBk="@drawable/step"
                                app:imageSize="25dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:textSize="0sp" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/distanceLayout"
                            android:layout_width="340dp"
                            android:layout_height="110dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/report_rect_circle_bk"
                            android:padding="8dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/stepLayout">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="运动距离"
                                android:textSize="14sp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/distanceCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:text="无数据"
                                android:textSize="28sp"
                                app:layout_constraintBottom_toTopOf="@id/distanceScore"
                                app:layout_constraintStart_toStartOf="parent" />

                            <TextView
                                android:id="@+id/distanceScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="14sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent" />

                            <com.nyzg.swiftsail.view.ReportCircle
                                android:id="@+id/distanceCircle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:circleBk="@color/rainGreen"
                                app:circleBk2="@color/heavyGreen"
                                app:circleSize="70dp"
                                app:imageBk="@drawable/location"
                                app:imageSize="25dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:textSize="0sp" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/fireLayout"
                            android:layout_width="340dp"
                            android:layout_height="110dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/report_rect_circle_bk"
                            android:padding="8dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/distanceLayout">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="消耗热量"
                                android:textSize="14sp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/fireCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:text="无数据"
                                android:textSize="28sp"
                                app:layout_constraintBottom_toTopOf="@id/fireScore"
                                app:layout_constraintStart_toStartOf="parent" />

                            <TextView
                                android:id="@+id/fireScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="14sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent" />

                            <com.nyzg.swiftsail.view.ReportCircle
                                android:id="@+id/fireCircle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:circleBk="@color/rainGreen"
                                app:circleBk2="@color/heavyGreen"
                                app:circleSize="70dp"
                                app:imageBk="@drawable/consumtion"
                                app:imageSize="25dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:textSize="0sp" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <TextView
                            android:id="@+id/textHealth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="18dp"
                            android:layout_marginTop="16dp"
                            android:text="健康"
                            android:textSize="18sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/fireLayout" />

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/heartLayout"
                            android:layout_width="340dp"
                            android:layout_height="110dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/report_rect_circle_bk"
                            android:padding="8dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/textHealth">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="心率"
                                android:textSize="14sp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/heartRange"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:text="无数据"
                                android:textSize="28sp"
                                app:layout_constraintBottom_toTopOf="@id/hearCalm"
                                app:layout_constraintStart_toStartOf="parent" />

                            <TextView
                                android:id="@+id/hearCalm"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="静息心率：无数据"
                                android:textSize="14sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent" />

                            <com.nyzg.swiftsail.view.ReportCircle
                                android:id="@+id/heartCircle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:circleBk="@color/rainBlue"
                                app:circleBk2="@color/heavyBlue"
                                app:circleSize="70dp"
                                app:imageBk="@drawable/heart"
                                app:imageSize="25dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:textSize="0sp" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <TextView
                            android:id="@+id/textNutri"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="18dp"
                            android:layout_marginTop="16dp"
                            android:text="营养"
                            android:textSize="18sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/heartLayout" />

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/foodLayout"
                            android:layout_width="340dp"
                            android:layout_height="110dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/report_rect_circle_bk"
                            android:padding="8dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/textNutri">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="饮食"
                                android:textSize="14sp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/foodCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="4dp"
                                android:text="无数据"
                                android:textSize="28sp"
                                app:layout_constraintBottom_toTopOf="@id/foodScore"
                                app:layout_constraintStart_toStartOf="parent" />

                            <TextView
                                android:id="@+id/foodScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="14sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent" />

                            <com.nyzg.swiftsail.view.ReportCircle
                                android:id="@+id/foodCircle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:circleBk="@color/rainPink"
                                app:circleBk2="@color/heavyPink"
                                app:circleSize="70dp"
                                app:imageBk="@drawable/nutrition"
                                app:imageSize="25dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:textSize="0sp" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottomContent"
            android:layout_width="match_parent"
            android:layout_height="500dp">

            <View
                android:id="@+id/pullUpBar"
                android:layout_width="90dp"
                android:layout_height="8dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/pull_up_bar"
                android:gravity="center|top"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/realTrack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:text="信息追踪"
                android:textSize="20sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/pullUpBar" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/addDevice"
                android:layout_width="140dp"
                android:layout_height="60dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/report_bottom_select"
                app:layout_constraintEnd_toStartOf="@id/mangeDevice"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/realTrack">

                <ImageView
                    android:id="@+id/imageView1"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/watch"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/darkGreen" />

                <TextView
                    android:id="@+id/textView1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="添加设备"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/imageView1"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/mangeDevice"
                android:layout_width="140dp"
                android:layout_height="60dp"
                android:background="@drawable/report_bottom_select"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/addDevice"
                app:layout_constraintTop_toTopOf="@id/addDevice">

                <ImageView
                    android:id="@+id/imageView2"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/delete"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/darkGreen" />

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="管理设备"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/imageView2"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/manualTrack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:text="手动记录"
                android:textSize="20sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/addDevice" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/food"
                android:layout_width="140dp"
                android:layout_height="60dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/report_bottom_select"
                app:layout_constraintStart_toStartOf="@id/addDevice"
                app:layout_constraintTop_toBottomOf="@id/manualTrack">

                <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/nutrition"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/darkGreen" />

                <TextView
                    android:id="@+id/textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="饮食"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/imageView"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/dataSync"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
