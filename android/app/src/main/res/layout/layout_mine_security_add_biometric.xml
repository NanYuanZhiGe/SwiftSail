<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="320dp"
        android:layout_height="360dp"
        android:background="@drawable/mine_security_add_biometric_bk"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="添加信任设备"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="请输入您账号的登录密码"
            android:textSize="18sp"
            app:layout_constraintBottom_toTopOf="@id/pwdInput"
            app:layout_constraintStart_toStartOf="@id/pwdInput" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/pwdInput"
            android:layout_width="240dp"
            android:layout_height="40dp"
            android:inputType="textPassword"
            android:background="@drawable/register_input"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/verify"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/register_button"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="验证"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="@id/pwdInput"
            app:layout_constraintTop_toBottomOf="@id/pwdInput" />

        <TextView
            android:id="@+id/cancel"
            android:layout_marginTop="4dp"
            android:background="@drawable/verify_code_button"
            app:layout_constraintEnd_toEndOf="@id/pwdInput"
            app:layout_constraintTop_toBottomOf="@id/verify"
            android:paddingVertical="8dp"
            android:paddingHorizontal="16dp"
            android:text="取消"
            android:textSize="16sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>