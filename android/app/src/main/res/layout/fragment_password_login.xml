<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="请输入密码:"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@id/pwdInput"
        app:layout_constraintStart_toStartOf="@id/pwdInput" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/pwdInput"
        android:layout_width="240dp"
        android:layout_height="80dp"
        android:background="@drawable/register_input"
        android:inputType="textPassword"
        app:layout_constraintBottom_toTopOf="@id/submitPwdVerify"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />


    <TextView
        android:id="@+id/submitPwdVerify"
        android:layout_width="200dp"
        android:layout_height="40dp"
        android:layout_margin="3dp"
        android:background="@drawable/verify_code_button"
        android:gravity="center"
        android:text="登录"
        android:textAlignment="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/pwdInput"
        app:layout_constraintStart_toStartOf="@id/pwdInput"
        app:layout_constraintTop_toBottomOf="@id/pwdInput" />


</androidx.constraintlayout.widget.ConstraintLayout>