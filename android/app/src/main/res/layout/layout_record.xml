<?xml version="1.0" encoding="utf-8"?>
<com.sothree.slidinguppanel.RoundedSlidingUpPanelLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:sothree="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:umanoOverlay="true"
    android:background="@color/white"
    android:gravity="bottom"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    sothree:umanoPanelHeight="68dp"
    sothree:umanoShadowHeight="10dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/record_top"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/layout_record_bk1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="500dp"
        android:background="@drawable/layout_sliding_panel_bk"
        android:elevation="@dimen/slidingPanelShadow">

        <View
            android:id="@+id/pullUpBar"
            android:layout_width="90dp"
            android:layout_height="8dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/pull_up_bar"
            android:gravity="center|top"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.sothree.slidinguppanel.RoundedSlidingUpPanelLayout>
