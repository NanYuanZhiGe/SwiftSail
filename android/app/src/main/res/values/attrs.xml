<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="SportLayout">
        <attr name="sportName" format="string" />
        <attr name="sportIcon" format="reference" />
    </declare-styleable>

    <declare-styleable name="MineFuncSelectLayout">
        <attr name="funcIcon" format="reference" />
        <attr name="iconTint" format="color|reference" />
        <attr name="funcName" format="string" />
        <attr name="textColor" format="reference" />
    </declare-styleable>

    <declare-styleable name="MineUserDataSelectLayout">
        <attr name="attributeName" format="string" />
    </declare-styleable>

    <declare-styleable name="ReportCircle">
        <attr name="circleSize" format="dimension" />
        <attr name="circleBk" format="color|reference" />
        <attr name="circleBk2" format="color|reference" />
        <attr name="imageSize" format="dimension" />
        <attr name="imageBk" format="reference" />
        <attr name="textSize" format="dimension" />
    </declare-styleable>

    <declare-styleable name="RoundedBarChart">
        <attr name="radius" format="dimension" />
    </declare-styleable>
</resources>